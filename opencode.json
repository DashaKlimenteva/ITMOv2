{
    "$schema":  "https://opencode.ai/config.json",
    "default_agent":  "build",
    "plugin": [
        "./.opencode/plugins/practice04-hook.js"
    ],
    "provider":  {
                      "vsellm":  {
                                     "npm":  "@ai-sdk/openai-compatible",
                                     "name":  "VseLLM",
                                     "options":  {
                                                    "baseURL":  "https://litellm.data-light.ru",
                                                    "apiKey":  "{env:VSELLM_API_KEY}"
                                                },
                                    "models":  {
                                                   "openai/gpt-5":  {
                                                                        "name":  "openai/gpt-5"
                                                                    },
                                                   "anthropic/claude-sonnet-4":  {
                                                                                     "name":  "anthropic/claude-sonnet-4"
                                                                                 }
                                               }
                                }
                 },
    "mcp":  {
                "demo-subscribers":  {
                                         "type":  "local",
                                         "command":  [
                                                         "practices/practice_04/mcp/demo-subscribers-tool/venv/Scripts/python.exe",
                                                         "practices/practice_04/mcp/demo-subscribers-tool/server.py"
                                                     ],
                                         "enabled":  true,
                                         "environment":  {
                                                             "PYTHONUNBUFFERED":  "1"
                                                         }
                                     }
            }
}
